# Copy to apps/api/.env (backend) — never commit real values.

# --- Backend --------------------------------------------------------------
APP_ENV=development                # development | test | staging | production
DATABASE_URL=postgresql+asyncpg://termrail:termrail@localhost:5432/termrail

# Auth: "local" (email/password stored here, HS256 JWT) or "supabase" (verify Supabase JWTs via JWKS)
AUTH_PROVIDER=local
JWT_SECRET=                        # required outside development/test: long random string
SUPABASE_URL=
SUPABASE_JWKS_URL=                 # e.g. https://<project>.supabase.co/auth/v1/.well-known/jwks.json

# Private storage for uploaded contracts and exported PDFs (never served publicly)
STORAGE_DIR=./var/storage
MAX_UPLOAD_BYTES=15728640

# AI provider: gemini | openai | none   ("fake" exists only for APP_ENV=test)
AI_PROVIDER=gemini
AI_MODEL=                          # default for gemini: gemini-3.5-flash; required for openai
AI_FALLBACK_MODELS=                # optional, comma separated, tried when the primary model is overloaded
AI_REASONING_EFFORT=low
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_MAX_INPUT_CHARS=48000
AI_CONCURRENCY=4

# Jobs
RUN_WORKER_IN_PROCESS=false        # true = run the worker inside the API process (single-container deploys)

# Web origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# P0 never sends anything externally; the API refuses to start if this is true.
ALLOW_EXTERNAL_SEND=false

# --- Web (public, baked into the bundle) -----------------------------------
VITE_API_URL=/api/v1
